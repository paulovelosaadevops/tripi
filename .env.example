# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Os dois valores são públicos por natureza;
# a segurança vem das regras RLS do banco. Nunca coloque a service_role key aqui.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Endereço da versão web publicada (EAS Hosting). Os links dos e-mails do Supabase levam para cá.
EXPO_PUBLIC_WEB_URL=https://SEU-APP.expo.app
# Logins sociais ligados no Supabase (Authentication → Providers). Ex.: google,apple. Vazio = só e-mail.
EXPO_PUBLIC_AUTH_PROVIDERS=
# Chave pública VAPID para notificações (npx web-push generate-vapid-keys). Vazio = lembretes desativados.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
