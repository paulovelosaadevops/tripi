# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Os dois valores são públicos por natureza;
# a segurança vem das regras RLS do banco. Nunca coloque a service_role key aqui.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
