{
  "expo": {
    "name": "Tripi",
    "slug": "tripi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tripi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.tripi"
    },
    "android": {
      "package": "app.tripi",
      "adaptiveIcon": {
        "backgroundColor": "#0B3D2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Tripi",
      "shortName": "Tripi",
      "lang": "pt-BR",
      "themeColor": "#0B3D2E",
      "backgroundColor": "#0B3D2E"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B3D2E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#06100D",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Tripi usa suas fotos para anexar documentos e comprovantes à viagem.",
          "cameraPermission": "O Tripi usa a câmera para fotografar documentos e comprovantes.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6bc1bbc3-fdd7-4c21-9994-aa0ae341fc0d"
      }
    },
    "owner": "paulovelosaaa"
  }
}
