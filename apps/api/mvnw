#!/bin/sh
BASE_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

if [ ! -f "$BASE_DIR/.mvn/wrapper/maven-wrapper.jar" ]; then
  echo "Maven Wrapper jar is missing. Install Maven locally or add the wrapper jar with mvn -N wrapper:wrapper." >&2
  exit 1
fi

exec java -classpath "$BASE_DIR/.mvn/wrapper/maven-wrapper.jar" "-Dmaven.multiModuleProjectDirectory=$BASE_DIR" org.apache.maven.wrapper.MavenWrapperMain "$@"
